# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required: exactly four ASCII digits. Preserve leading zeroes as a string.
# Never use a VITE_ variable for this access code.
APP_ACCESS_KEY=
HOST=127.0.0.1
PORT=3000
# Production: use a trusted certificate and key, or a TLS reverse proxy on loopback.
TLS_CERT_PATH=
TLS_KEY_PATH=
TRUST_LOOPBACK_PROXY=false

# MiniMax M3 companion chat and TTS (shared API key). Server-side only; never use VITE_ or put the key in the browser.
MINIMAX_API_KEY=

# Optional QQ service overrides. Defaults: embedded API and a persisted generated key.
QQ_MUSIC_API_URL=
QQ_SESSION_SECRET=
