{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soundisle-backend",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH",
        "class_name": "AuthStore"
      },
      {
        "name": "MUSIC",
        "class_name": "MusicStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuthStore"
      ]
    },
    {
      "tag": "v2-music",
      "new_sqlite_classes": [
        "MusicStore"
      ]
    }
  ]
}
