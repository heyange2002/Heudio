{
  "name": "soundisle-pc",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-qq-music-api.mjs",
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-icons.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "node --test tests/security.test.mjs",
    "cf:dev": "wrangler dev",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy --keep-vars",
    "test:ui": "node tests/run-ui.mjs",
    "test:speech": "node --test tests/speech.test.mjs",
    "test:speech-runtime": "node --test tests/speech-runtime.test.mjs",
    "test:companion": "node --test tests/companion.test.mjs",
    "test:music": "node --test tests/music.test.mjs tests/qr-bootstrap.test.mjs tests/playback.test.mjs",
    "test:music-runtime": "node --test tests/music-runtime.test.mjs",
    "test:transcribe": "node --test tests/transcribe.test.mjs",
    "pc:dev": "npm run build:pc && electron .",
    "build:pc": "npm run build && node scripts/build-desktop.mjs",
    "pc:start": "electron .",
    "pc:pack": "npm run build:pc && electron-builder --dir",
    "pc:dist": "npm run build:pc && electron-builder",
    "test:desktop": "npm run build:pc && electron . --smoke-test",
    "test:settings": "node --test tests/local-provider-settings.test.mjs",
    "test:memory": "node --test tests/agent-memory.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@yakult-green-tea/qq-music-api": "3.3.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "miniflare": "5.20261102.0-beta",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "description": "声屿 SoundIsle PC 版 · 音乐与心境陪伴",
  "main": "desktop/main.cjs"
}
