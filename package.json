{
  "name": "heudio", "version": "0.4.0", "private": true,
  "workspaces": ["frontend", "backend", "services/qq-music-api"],
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:music": "npm start -w services/qq-music-api",
    "build:frontend": "node scripts/build-frontend.mjs",
    "test": "node --test backend/test/*.test.mjs && node tests/providers.test.cjs && node tests/ambient.test.cjs",
    "start": "npm start -w backend"
  }
}
